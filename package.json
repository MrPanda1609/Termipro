{
  "name": "termipro",
  "version": "1.0.16",
  "description": "Modern terminal for AI coding",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run build:electron\" \"vite\" \"npm run electron:start\"",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "electron:start": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:electron": "esbuild electron/main.js --bundle --platform=node --outfile=dist-electron/main.js --external:electron --external:node-pty --external:electron-updater",
    "preview": "vite preview",
    "electron:build": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "bluebird": "^3.7.2",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0",
    "source-map": "^0.6.1",
    "truncate-utf8-bytes": "^1.0.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.9.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.1",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.termipro.app",
    "productName": "Termipro",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "pic/icon.png",
      "artifactName": "Termipro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Termipro"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrPanda1609",
        "repo": "Termipro",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "pic/**/*",
      "node_modules/node-pty/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  }
}
